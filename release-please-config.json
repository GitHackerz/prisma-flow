{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "skip-github-release": true,
  "skip-changelog": true,
  "packages": {
    "packages/cli": {
      "component": "prisma-flow",
      "package-name": "prisma-flow"
    },
    "packages/shared": {
      "component": "prisma-flow-shared",
      "package-name": "@prisma-flow/shared"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "prisma-flow-packages",
      "components": ["prisma-flow", "prisma-flow-shared"]
    }
  ]
}
